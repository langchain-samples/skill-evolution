# Copy to .env and fill in. .env is gitignored -- never commit real keys.
# Keep this file's values EMPTY: .env.example is tracked, .env is not.

# Required: LangSmith workspace credentials.
# Alternatively, authenticate the langsmith CLI (`langsmith login`) and leave this unset;
# the SDK will use the OAuth profile in ~/.langsmith/config.json.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Project that session traces are written to and harvested from.
LANGSMITH_PROJECT=skill-evolution
LANGSMITH_TRACING=true

# Model credentials. If you route through the LangSmith AI gateway, set both of these
# and use your LangSmith key as ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://gateway.smith.langchain.com/anthropic

# Model roles (override to trade cost against quality).
# The agent under test is deliberately small -- see the note in README Setup.
SKILLEVO_AGENT_MODEL=anthropic:claude-haiku-4-5-20251001
SKILLEVO_REFLECT_MODEL=anthropic:claude-opus-5
SKILLEVO_JUDGE_MODEL=anthropic:claude-sonnet-5

# --- Reproducibility knobs (all optional; defaults shown) ---
# Agent decoding temperature. 0 keeps holdout scores comparable run to run.
SKILLEVO_AGENT_TEMPERATURE=0.0
# Times each holdout example is scored per experiment. 1 is too coarse to gate on.
SKILLEVO_EVAL_REPETITIONS=3
SKILLEVO_EVAL_CONCURRENCY=4
# A candidate must beat the best composite by more than this to be kept.
SKILLEVO_GATE_MARGIN=0.02
# Tag isolating one loop invocation's traces from every earlier one, so a re-run does
# not harvest the previous run's sessions. Allowlisted to [A-Za-z0-9._-], max 64 chars.
# SKILLEVO_RUN_ID=
